<%- include('partials/header') %>
    <main class="container">
        <div class="card">
            <h1 style="margin-bottom: 0.5rem;">
                <%= poll.question %>
            </h1>
            <h3 style="color: var(--text-muted); margin-bottom: 2rem; font-weight: 500;">Total Votes: <%= totalVotes %>
            </h3>

            <form action="/vote/<%= poll.id %>" method="POST">
                <div style="display: flex; flex-direction: column; gap: 1rem; margin-bottom: 2rem;">
                    <% options.forEach((opt)=> { %>
                        <label
                            style="display: flex; align-items: center; padding: 1rem; border: 1px solid var(--border-color); border-radius: var(--radius-md); cursor: pointer; transition: var(--transition); background: var(--bg-color);">
                            <input type="radio" name="optionId" value="<%= opt.id %>" required
                                style="margin-right: 1rem; transform: scale(1.2); accent-color: var(--primary);">
                            <span style="flex-grow: 1; font-weight: 500;">
                                <%= opt.text %>
                            </span>
                            <span style="font-weight: 600; color: var(--primary);">
                                <%= opt.votes %> votes
                            </span>
                        </label>
                        <% }) %>
                </div>
                <div style="display: flex; gap: 1rem;">
                    <button type="submit" class="btn btn-primary" style="flex: 1;">Cast Vote</button>
                    <a href="/" class="btn"
                        style="border: 1px solid var(--border-color); color: var(--text-main);">Create New Poll</a>
                </div>
            </form>
        </div>
    </main>
    <%- include('partials/footer') %>