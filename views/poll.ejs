<%- include('partials/header') %>
    <style>
        /* Custom Radio Animation */
        .option-label {
            display: flex;
            align-items: center;
            padding: 1.25rem 1.5rem;
            border: 2px solid var(--border-color);
            border-radius: var(--radius-lg);
            cursor: pointer;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            background: var(--card-bg);
            position: relative;
            overflow: hidden;
        }

        .option-label-voted {
            cursor: default;
            border-color: var(--border-color);
        }

        .option-label:not(.option-label-voted):hover {
            border-color: var(--primary-hover);
            transform: translateY(-2px);
            box-shadow: 0 10px 15px -3px rgba(79, 70, 229, 0.1);
        }

        .option-label input[type="radio"],
        .option-label input[type="checkbox"] {
            position: absolute;
            opacity: 0;
            cursor: pointer;
            width: 0;
            height: 0;
        }

        .custom-radio {
            width: 24px;
            height: 24px;
            border: 2px solid var(--border-color);
            margin-right: 1.25rem;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s ease;
            flex-shrink: 0;
        }

        .custom-radio[data-multiple="false"] {
            border-radius: 50%;
        }

        .custom-radio[data-multiple="true"] {
            border-radius: 4px;
        }

        .custom-radio::after {
            content: "";
            width: 12px;
            height: 12px;
            background: var(--primary);
            transform: scale(0);
            transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        .custom-radio[data-multiple="false"]::after {
            border-radius: 50%;
        }

        .custom-radio[data-multiple="true"]::after {
            border-radius: 2px;
        }

        .option-label input:checked~.custom-radio {
            border-color: var(--primary);
        }

        .option-label input:checked~.custom-radio::after {
            transform: scale(1);
        }

        .option-label:has(input:checked) {
            border-color: var(--primary);
            background: rgba(79, 70, 229, 0.05);
        }

        [data-theme='dark'] .option-label:has(input:checked) {
            background: rgba(79, 70, 229, 0.15);
        }

        .option-text {
            flex-grow: 1;
            font-weight: 500;
            font-size: 1.1rem;
            color: var(--text-main);
        }

        .option-votes {
            font-weight: 700;
            color: var(--primary);
            background: rgba(79, 70, 229, 0.1);
            padding: 0.35rem 0.85rem;
            border-radius: 999px;
            font-size: 0.9rem;
        }

        .poll-header {
            text-align: center;
            margin-bottom: 3rem;
        }

        .poll-title {
            font-size: 2.5rem;
            margin-bottom: 0.5rem;
            line-height: 1.2;
        }

        .poll-meta {
            color: var(--text-muted);
            font-size: 1.1rem;
            font-weight: 500;
        }

        .action-buttons {
            display: flex;
            gap: 1rem;
            margin-top: 2rem;
        }

        .btn-vote {
            flex: 2;
            font-size: 1.1rem;
            padding: 1rem;
            border-radius: var(--radius-lg);
        }

        .btn-secondary {
            flex: 1;
            background: transparent;
            border: 2px solid var(--border-color);
            color: var(--text-main);
            border-radius: var(--radius-lg);
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .btn-secondary:hover {
            background: var(--border-color);
            color: var(--text-main);
        }

        .progress-bar {
            position: absolute;
            top: 0;
            left: 0;
            height: 100%;
            background: rgba(79, 70, 229, 0.1);
            z-index: 0;
            transition: width 1s cubic-bezier(0.34, 1.56, 0.64, 1);
            border-radius: var(--radius-lg);
        }

        [data-theme='dark'] .progress-bar {
            background: rgba(79, 70, 229, 0.2);
        }

        .option-content {
            position: relative;
            z-index: 1;
            display: flex;
            align-items: center;
            width: 100%;
        }
    </style>

    <main class="container" style="max-width: 800px; padding-top: 4rem;">
        <div class="card" style="border-radius: var(--radius-lg); padding: 3rem;">
            <div class="poll-header">
                <h1 class="poll-title">
                    <%= poll.question %>
                </h1>
                <p class="poll-meta">Total Votes: <%= totalVotes %>
                </p>
                <% if (poll.allowMultiple) { %>
                    <p style="color: var(--primary); font-size: 0.9rem; margin-top: 0.5rem;">Multiple selections
                        permitted.</p>
                    <% } %>
                        <% if (poll.expiresAt && !isExpired) { %>
                            <p style="color: var(--text-muted); font-size: 0.9rem; margin-top: 0.25rem;">Expires on: <%=
                                    poll.expiresAt.toLocaleString() %>
                            </p>
                            <% } %>
            </div>

            <% if (hasVoted || isExpired) { %>
                <div style="text-align: center; margin-bottom: 2rem;">
                    <div
                        style="background: rgba(79, 70, 229, 0.1); color: var(--primary); padding: 1rem; border-radius: var(--radius-md); font-weight: 600; font-size: 1.1rem; display: inline-flex; align-items: center;">
                        <svg style="width: 24px; height: 24px; margin-right: 0.5rem;" fill="none" stroke="currentColor"
                            viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        <%= isExpired && !hasVoted ? 'This poll has expired and is no longer capturing votes.'
                            : 'You have already voted on this poll.' %>
                    </div>
                </div>
                <div style="display: flex; flex-direction: column; gap: 1.25rem; margin-bottom: 1rem;">
                    <% options.forEach((opt)=> { %>
                        <% const percent=totalVotes===0 ? 0 : Math.round((opt.votes / totalVotes) * 100); %>
                            <div class="option-label option-label-voted" id="label-<%= opt.id %>">
                                <div class="progress-bar" id="progress-<%= opt.id %>" style="width: <%= percent %>%">
                                </div>
                                <div class="option-content">
                                    <span class="option-text">
                                        <%= opt.text %>
                                    </span>
                                    <span class="option-votes" id="vote-count-<%= opt.id %>">
                                        <%= opt.votes %> votes (<%= percent %>%)
                                    </span>
                                </div>
                            </div>
                            <% }) %>
                </div>
                <div class="action-buttons">
                    <a href="/" class="btn btn-secondary" style="flex: 2; height: 3.5rem;">Create New Poll</a>
                    <button type="button" class="btn btn-primary"
                        onclick="document.getElementById('shareModal').style.display='flex'"
                        style="flex: 1; height: 3.5rem;">Share</button>
                </div>
                <% } else { %>
                    <form action="/vote/<%= poll.id %>" method="POST">
                        <div style="display: flex; flex-direction: column; gap: 1.25rem; margin-bottom: 1rem;">
                            <% const inputType=poll.allowMultiple ? 'checkbox' : 'radio' ; %>
                                <% options.forEach((opt)=> { %>
                                    <% const percent=totalVotes===0 ? 0 : Math.round((opt.votes / totalVotes) * 100); %>
                                        <label class="option-label" id="label-<%= opt.id %>">
                                            <div class="progress-bar" id="progress-<%= opt.id %>"
                                                style="width: <%= percent %>%"></div>
                                            <div class="option-content">
                                                <input type="<%= inputType %>" name="optionId" value="<%= opt.id %>"
                                                    <%=poll.allowMultiple ? '' : 'required' %>>
                                                <div class="custom-radio" data-multiple="<%= poll.allowMultiple %>">
                                                </div>
                                                <span class="option-text">
                                                    <%= opt.text %>
                                                </span>
                                                <span class="option-votes" id="vote-count-<%= opt.id %>">
                                                    <%= opt.votes %> votes (<%= percent %>%)
                                                </span>
                                            </div>
                                        </label>
                                        <% }) %>
                        </div>
                        <div class="action-buttons">
                            <button type="submit" class="btn btn-primary btn-vote">Submit Vote</button>
                            <button type="button" class="btn btn-secondary"
                                onclick="document.getElementById('shareModal').style.display='flex'">Share</button>
                        </div>
                    </form>
                    <% } %>
        </div>
    </main>

    <div id="shareModal"
        style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 1000; justify-content: center; align-items: center; backdrop-filter: blur(4px);">
        <div class="card" style="position: relative; text-align: center; max-width: 400px; width: 90%;">
            <button onclick="document.getElementById('shareModal').style.display='none'"
                style="position: absolute; top: 1rem; right: 1rem; background: none; border: none; font-size: 1.5rem; cursor: pointer; color: var(--text-muted);">&times;</button>
            <h2 style="font-family: var(--font-display); margin-bottom: 0.5rem;">Share Poll</h2>
            <p style="color: var(--text-muted); font-size: 0.9rem;">Scan or copy the link below.</p>
            <img src="<%= qrCodeDataUrl %>" alt="QR Code"
                style="margin: 1.5rem 0; border-radius: 8px; width: 200px; height: 200px; display: block; margin-left: auto; margin-right: auto;">
            <div style="display: flex; gap: 0.5rem; margin-top: 1rem;">
                <input type="text" id="shareUrl" value="<%= url %>" readonly class="form-input"
                    style="flex: 1; padding: 0.75rem; border: 1px solid var(--border-color); border-radius: var(--radius-md); background: var(--bg-color); color: var(--text-main);">
                <button onclick="copyLink()" class="btn btn-primary" id="copyBtn"
                    style="padding: 0.75rem 1.5rem;">Copy</button>
            </div>
        </div>
    </div>

    <script src="/socket.io/socket.io.js"></script>
    <script>
        const socket = io();
        const pollId = "<%= poll.id %>";

        socket.emit('join_poll', pollId);

        socket.on('vote_update', (data) => {
            document.querySelector('.poll-meta').innerText = `Total Votes: ${data.totalVotes}`;
            data.options.forEach(opt => {
                const percent = data.totalVotes === 0 ? 0 : Math.round((opt.votes / data.totalVotes) * 100);

                const voteSpan = document.getElementById(`vote-count-${opt.id}`);
                if (voteSpan) {
                    voteSpan.innerText = `${opt.votes} votes (${percent}%)`;
                }

                const pb = document.getElementById(`progress-${opt.id}`);
                if (pb) {
                    pb.style.width = `${percent}%`;
                }
            });
        });

        function copyLink() {
            const copyText = document.getElementById("shareUrl");
            copyText.select();
            document.execCommand("copy");
            const btn = document.getElementById("copyBtn");
            btn.innerText = "Copied!";
            setTimeout(() => { btn.innerText = "Copy"; }, 2000);
        }
    </script>

    <%- include('partials/footer') %>