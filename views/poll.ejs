<%- include('partials/header') %>
    <style>
        /* Custom Radio Animation */
        .option-label {
            display: flex;
            align-items: center;
            padding: 1.25rem 1.5rem;
            border: 2px solid var(--border-color);
            border-radius: var(--radius-lg);
            cursor: pointer;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            background: var(--card-bg);
            position: relative;
            overflow: hidden;
        }

        .option-label:hover {
            border-color: var(--primary-hover);
            transform: translateY(-2px);
            box-shadow: 0 10px 15px -3px rgba(79, 70, 229, 0.1);
        }

        .option-label input[type="radio"] {
            position: absolute;
            opacity: 0;
            cursor: pointer;
            width: 0;
            height: 0;
        }

        .custom-radio {
            width: 24px;
            height: 24px;
            border: 2px solid var(--border-color);
            border-radius: 50%;
            margin-right: 1.25rem;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s ease;
            flex-shrink: 0;
        }

        .custom-radio::after {
            content: "";
            width: 12px;
            height: 12px;
            background: var(--primary);
            border-radius: 50%;
            transform: scale(0);
            transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        .option-label input[type="radio"]:checked~.custom-radio {
            border-color: var(--primary);
        }

        .option-label input[type="radio"]:checked~.custom-radio::after {
            transform: scale(1);
        }

        .option-label:has(input[type="radio"]:checked) {
            border-color: var(--primary);
            background: rgba(79, 70, 229, 0.05);
        }

        [data-theme='dark'] .option-label:has(input[type="radio"]:checked) {
            background: rgba(79, 70, 229, 0.15);
        }

        .option-text {
            flex-grow: 1;
            font-weight: 500;
            font-size: 1.1rem;
            color: var(--text-main);
        }

        .option-votes {
            font-weight: 700;
            color: var(--primary);
            background: rgba(79, 70, 229, 0.1);
            padding: 0.35rem 0.85rem;
            border-radius: 999px;
            font-size: 0.9rem;
        }

        .poll-header {
            text-align: center;
            margin-bottom: 3rem;
        }

        .poll-title {
            font-size: 2.5rem;
            margin-bottom: 0.5rem;
            line-height: 1.2;
        }

        .poll-meta {
            color: var(--text-muted);
            font-size: 1.1rem;
            font-weight: 500;
        }

        .action-buttons {
            display: flex;
            gap: 1rem;
            margin-top: 2rem;
        }

        .btn-vote {
            flex: 2;
            font-size: 1.1rem;
            padding: 1rem;
            border-radius: var(--radius-lg);
        }

        .btn-secondary {
            flex: 1;
            background: transparent;
            border: 2px solid var(--border-color);
            color: var(--text-main);
            border-radius: var(--radius-lg);
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .btn-secondary:hover {
            background: var(--border-color);
            color: var(--text-main);
        }

        /* Progress Bar Visualization */
        .progress-bar {
            position: absolute;
            top: 0;
            left: 0;
            height: 100%;
            background: rgba(79, 70, 229, 0.1);
            z-index: 0;
            transition: width 1s cubic-bezier(0.34, 1.56, 0.64, 1);
            border-radius: var(--radius-lg);
        }

        [data-theme='dark'] .progress-bar {
            background: rgba(79, 70, 229, 0.2);
        }

        .option-content {
            position: relative;
            z-index: 1;
            display: flex;
            align-items: center;
            width: 100%;
        }
    </style>

    <main class="container" style="max-width: 800px; padding-top: 4rem;">
        <div class="card" style="border-radius: var(--radius-lg); padding: 3rem;">
            <div class="poll-header">
                <h1 class="poll-title">
                    <%= poll.question %>
                </h1>
                <p class="poll-meta">Total Votes: <%= totalVotes %>
                </p>
            </div>

            <form action="/vote/<%= poll.id %>" method="POST">
                <div style="display: flex; flex-direction: column; gap: 1.25rem; margin-bottom: 1rem;">
                    <% options.forEach((opt)=> { %>
                        <% const percent=totalVotes===0 ? 0 : Math.round((opt.votes / totalVotes) * 100); %>
                            <label class="option-label" id="label-<%= opt.id %>">
                                <div class="progress-bar" id="progress-<%= opt.id %>" style="width: <%= percent %>%">
                                </div>
                                <div class="option-content">
                                    <input type="radio" name="optionId" value="<%= opt.id %>" required>
                                    <div class="custom-radio"></div>
                                    <span class="option-text">
                                        <%= opt.text %>
                                    </span>
                                    <span class="option-votes" id="vote-count-<%= opt.id %>">
                                        <%= opt.votes %> votes (<%= percent %>%)
                                    </span>
                                </div>
                            </label>
                            <% }) %>
                </div>
                <div class="action-buttons">
                    <button type="submit" class="btn btn-primary btn-vote">Submit Vote</button>
                    <a href="/" class="btn btn-secondary">Create Poll</a>
                </div>
            </form>
        </div>
    </main>

    <script src="/socket.io/socket.io.js"></script>
    <script>
        const socket = io();
        const pollId = "<%= poll.id %>";

        socket.emit('join_poll', pollId);

        socket.on('vote_update', (data) => {
            document.querySelector('.poll-meta').innerText = `Total Votes: ${data.totalVotes}`;
            data.options.forEach(opt => {
                const percent = data.totalVotes === 0 ? 0 : Math.round((opt.votes / data.totalVotes) * 100);

                const voteSpan = document.getElementById(`vote-count-${opt.id}`);
                if (voteSpan) voteSpan.innerText = `${opt.votes} votes (${percent}%)`;

                const pb = document.getElementById(`progress-${opt.id}`);
                if (pb) pb.style.width = `${percent}%`;
            });
        });
    </script>

    <%- include('partials/footer') %>