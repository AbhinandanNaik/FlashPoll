<%- include('partials/header') %>
    <main class="container">
        <div class="card">
            <h1 style="margin-bottom: 2rem; text-align: center;">Enterprise FlashPoll</h1>
            <form action="/create" method="POST">
                <div style="margin-bottom: 1.5rem;">
                    <label for="question" style="display:block; margin-bottom: 0.5rem; font-weight: 500;">Poll
                        Question</label>
                    <input type="text" id="question" name="question" placeholder="e.g. Best JavaScript Framework?"
                        required
                        style="width: 100%; padding: 0.75rem; border: 1px solid var(--border-color); border-radius: var(--radius-md); background: var(--bg-color); color: var(--text-main); font-family: var(--font-sans); outline: none;">
                </div>
                <div style="margin-bottom: 2rem;">
                    <label for="options" style="display:block; margin-bottom: 0.5rem; font-weight: 500;">Options (One
                        per line)</label>
                    <textarea id="options" name="options" rows="5" placeholder="React&#10;Vue&#10;Svelte" required
                        style="width: 100%; padding: 0.75rem; border: 1px solid var(--border-color); border-radius: var(--radius-md); background: var(--bg-color); color: var(--text-main); font-family: var(--font-sans); outline: none; resize: vertical;"></textarea>
                </div>
                <button type="submit" class="btn btn-primary" style="width: 100%;">Create Poll</button>
            </form>
        </div>
    </main>
    <%- include('partials/footer') %>