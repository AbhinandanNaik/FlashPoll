<%- include('partials/header') %>
    <main class="container" style="max-width: 800px; padding-top: 4rem;">
        <div style="text-align: center; margin-bottom: 3rem;">
            <h1
                style="font-size: 3rem; margin-bottom: 1rem; background: var(--gradient-primary); -webkit-background-clip: text; color: transparent; font-family: var(--font-display);">
                Create a FlashPoll</h1>
            <p style="color: var(--text-muted); font-size: 1.2rem;">Engage your audience with real-time, interactive
                polling.</p>
        </div>

        <div class="card" style="border-radius: var(--radius-lg); padding: 3rem;">
            <form action="/create" method="POST">
                <div class="form-group" style="margin-bottom: 2rem;">
                    <label for="question"
                        style="display: block; font-weight: 500; margin-bottom: 0.75rem; color: var(--text-main);">Poll
                        Question</label>
                    <input type="text" id="question" name="question" required class="form-input"
                        placeholder="What's your favorite programming language?"
                        style="width: 100%; padding: 1rem; font-size: 1.1rem;">
                </div>

                <div class="form-group" style="margin-bottom: 1.5rem;">
                    <label
                        style="display: block; font-weight: 500; margin-bottom: 1rem; color: var(--text-main);">Options
                        (Drag to reorder)</label>
                    <div id="options-container">
                        <div class="option-item" draggable="true">
                            <span class="drag-handle"
                                style="cursor: grab; color: var(--text-muted); padding: 0 0.5rem;">&#x2630;</span>
                            <input type="text" name="options" required class="form-input" placeholder="Option 1"
                                style="flex: 1; padding: 0.875rem;">
                            <button type="button" class="btn btn-secondary delete-btn"
                                style="padding: 0.5rem 1rem;">&times;</button>
                        </div>
                        <div class="option-item" draggable="true">
                            <span class="drag-handle"
                                style="cursor: grab; color: var(--text-muted); padding: 0 0.5rem;">&#x2630;</span>
                            <input type="text" name="options" required class="form-input" placeholder="Option 2"
                                style="flex: 1; padding: 0.875rem;">
                            <button type="button" class="btn btn-secondary delete-btn"
                                style="padding: 0.5rem 1rem;">&times;</button>
                        </div>
                    </div>
                    <button type="button" class="btn btn-secondary" onclick="addOption()"
                        style="width: 100%; margin-top: 1rem; border-style: dashed; padding: 1rem;">
                        + Add Another Option
                    </button>
                </div>

                <!-- Advanced Settings -->
                <div style="margin-top: 2rem; padding-top: 1.5rem; border-top: 1px dashed var(--border-color);">
                    <h3 style="font-size: 1.1rem; margin-bottom: 1rem; color: var(--text-main);">Advanced Settings</h3>

                    <label
                        style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.25rem; cursor: pointer;">
                        <input type="checkbox" name="allowMultiple" value="true"
                            style="width: 1.2rem; height: 1.2rem; cursor: pointer; accent-color: var(--primary);">
                        <span style="color: var(--text-main); font-weight: 500;">Allow Multiple Choices</span>
                    </label>

                    <label style="display: flex; flex-direction: column; gap: 0.5rem;">
                        <span style="color: var(--text-main); font-weight: 500;">Poll Expiration Limits</span>
                        <select name="expiresIn" class="form-input"
                            style="width: 100%; max-width: 300px; padding: 0.75rem;">
                            <option value="">Never Expires (Persistent)</option>
                            <option value="1">1 Hour</option>
                            <option value="24">24 Hours</option>
                            <option value="168">7 Days (1 Week)</option>
                        </select>
                    </label>
                </div>

                <button type="submit" class="btn btn-primary"
                    style="width: 100%; margin-top: 2rem; font-size: 1.1rem; padding: 1rem;">
                    Create Poll
                </button>
            </form>
        </div>
    </main>

    <style>
        .option-item {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            margin-bottom: 0.75rem;
            transition: transform 0.2s ease, opacity 0.2s ease;
        }

        .option-item.dragging {
            opacity: 0.5;
        }
    </style>

    <script>
        const container = document.getElementById('options-container');

        function addOption() {
            const item = document.createElement('div');
            item.className = 'option-item';
            item.draggable = true;
            item.innerHTML = `
      <span class="drag-handle" style="cursor: grab; color: var(--text-muted); padding: 0 0.5rem;">&#x2630;</span>
      <input type="text" name="options" required class="form-input" placeholder="New Option" style="flex: 1; padding: 0.875rem;">
      <button type="button" class="btn btn-secondary delete-btn" style="padding: 0.5rem 1rem;">&times;</button>
    `;
            container.appendChild(item);
            attachDragEvents(item);
        }

        container.addEventListener('click', (e) => {
            if (e.target.classList.contains('delete-btn')) {
                if (container.children.length > 2) {
                    e.target.closest('.option-item').remove();
                } else {
                    alert("A poll needs at least two options.");
                }
            }
        });

        function attachDragEvents(item) {
            item.addEventListener('dragstart', () => {
                item.classList.add('dragging');
            });
            item.addEventListener('dragend', () => {
                item.classList.remove('dragging');
            });
        }

        document.querySelectorAll('.option-item').forEach(attachDragEvents);

        container.addEventListener('dragover', (e) => {
            e.preventDefault();
            const afterElement = getDragAfterElement(container, e.clientY);
            const dragging = document.querySelector('.dragging');
            if (afterElement == null) {
                container.appendChild(dragging);
            } else {
                container.insertBefore(dragging, afterElement);
            }
        });

        function getDragAfterElement(container, y) {
            const draggableElements = [...container.querySelectorAll('.option-item:not(.dragging)')];
            return draggableElements.reduce((closest, child) => {
                const box = child.getBoundingClientRect();
                const offset = y - box.top - box.height / 2;
                if (offset < 0 && offset > closest.offset) {
                    return { offset: offset, element: child };
                } else {
                    return closest;
                }
            }, { offset: Number.NEGATIVE_INFINITY }).element;
        }
    </script>
    <%- include('partials/footer') %>