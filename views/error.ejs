<%- include('partials/header') %>
    <main class="container" style="display: flex; align-items: center; justify-content: center; min-height: 80vh;">
        <div class="card" style="text-align: center; max-width: 500px; width: 100%;">
            <div style="font-size: 3rem; margin-bottom: 1rem;">⚠️</div>
            <h1 style="margin-bottom: 1rem; color: var(--accent);">Error <%= status %>
            </h1>
            <p style="color: var(--text-muted); margin-bottom: 2rem; line-height: 1.5;">
                <%= msg %>
            </p>
            <a href="/" class="btn btn-primary">Return to Home</a>
        </div>
    </main>
    <%- include('partials/footer') %>